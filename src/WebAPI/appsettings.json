{
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
                }
            },
            {
                "Name": "File",
                "Args": {
                    "path": "logs/logs-.txt",
                    "rollingInterval": "Day"
                }
            }
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Information",
                "Microsoft.AspNetCore": "Warning",
                "System": "Warning"
            }
        }
    },
    "DefaultConnection": {
        "DefaultConnection": "Host=_Host__;Port=__port__;Database=_DBname_;Username=_Username_;Password=_Password_",
        "RedisConnection": "localhost:6379,password=_Password_,abortConnect=true,name=slyce-api"
    },
    "FatSecretSettings": {
        "baseUrl": "https://platform.fatsecret.com/rest/foods/search/v4?search_expression=",
        "tokenUrl": "https://oauth.fatsecret.com/connect/token",
        "grantType": "client_credentials",
        "clientId": "_CLIENT_ID-",
        "clientSecret": "_CLIENT_SECRET_",
        "scopes": "premier"
    },
    "JwtSettings": {
        "Secret": "__SECRET_KEY__",
        "Issuer": "slyce-api",
        "Audience": "slyce-client",
        "ExpiryHours": 1
    },
    "AllowedHosts": "*"
}
